{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "series_key",
    "layer",
    "status",
    "version",
    "title",
    "summary",
    "statement",
    "source_case_refs",
    "evidence_refs",
    "why_it_is_stable",
    "scope",
    "non_scope",
    "applicability_conditions",
    "non_applicability_conditions",
    "known_breakers",
    "tool_agnosticity_level",
    "confidence",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" },
    "series_key": { "type": "string", "minLength": 1 },
    "layer": { "type": "string", "const": "invariant" },
    "status": { "type": "string", "enum": ["draft", "active", "superseded", "deprecated", "rejected"] },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "source_case_refs": { "type": "array", "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" } },
    "why_it_is_stable": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "applicability_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_applicability_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "known_breakers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tool_agnosticity_level": { "type": "string", "enum": ["high", "medium", "low"] },
    "review_due_at": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" },
    "superseded_by": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
