{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "definition_id",
    "parameter_key",
    "raw_value_text",
    "value_type",
    "value_json",
    "observation_kind",
    "observed_at",
    "project_scope",
    "source_evidence_refs",
    "source_spans",
    "strategy_id",
    "extracted_at",
    "extracted_by",
    "confidence"
  ],
  "properties": {
    "observation_id": { "type": "string", "pattern": "^paramobs_[A-Za-z0-9_-]+$" },
    "definition_id": { "type": "string", "pattern": "^paramdef_[A-Za-z0-9_-]+$" },
    "parameter_key": { "type": "string", "minLength": 1 },
    "raw_value_text": { "type": "string" },
    "value_type": {
      "type": "string",
      "enum": ["string", "number", "boolean", "null", "object", "array", "unknown"]
    },
    "value_json": {},
    "observation_kind": { "type": "string", "enum": ["set", "observed", "unset"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "project_scope": { "type": "string", "enum": ["project", "project_family", "global", "blocked"] },
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_line",
          "end_line",
          "start_char",
          "end_char",
          "quote"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 },
          "start_char": { "type": "integer", "minimum": 0 },
          "end_char": { "type": "integer", "minimum": 0 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strategy_id": { "type": "string", "minLength": 1 },
    "extracted_at": { "type": "string", "format": "date-time" },
    "extracted_by": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "units": { "type": "string", "minLength": 1 },
    "tool_binding": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "environment_bounds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "supersedes": { "type": "string", "pattern": "^paramobs_[A-Za-z0-9_-]+$" }
  }
}
