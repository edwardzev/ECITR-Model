{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_set_id",
    "evidence_id",
    "source_hash",
    "extracted_at",
    "extracted_by",
    "strategy_id",
    "claims"
  ],
  "properties": {
    "claim_set_id": { "type": "string", "pattern": "^claimset_[A-Za-z0-9_-]+$" },
    "evidence_id": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" },
    "source_hash": { "type": "string", "minLength": 1 },
    "extracted_at": { "type": "string", "format": "date-time" },
    "extracted_by": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "kind",
          "confidence",
          "source_spans"
        ],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^claim_[A-Za-z0-9_-]+$" },
          "text": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["fact", "constraint", "decision", "rationale", "observation"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_line",
                "end_line",
                "start_char",
                "end_char",
                "quote"
              ],
              "properties": {
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "start_char": { "type": "integer", "minimum": 0 },
                "end_char": { "type": "integer", "minimum": 0 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
