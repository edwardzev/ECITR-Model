{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "candidate_id",
    "layer",
    "status",
    "workspace_id",
    "promotion_basis",
    "derivation_method",
    "source_case_refs",
    "supporting_invariant_refs",
    "evidence_refs",
    "entry",
    "support_signals",
    "counterexample_case_refs",
    "created_at",
    "last_seen_at",
    "revision",
    "decision_history"
  ],
  "properties": {
    "artifact_type": { "type": "string", "const": "live_tactic_candidate" },
    "candidate_id": { "type": "string", "pattern": "^ltc_[A-Za-z0-9_-]+$" },
    "candidate_series_id": { "type": "string", "pattern": "^ltc_[A-Za-z0-9_-]+$" },
    "supersedes_candidate_id": { "type": "string", "pattern": "^ltc_[A-Za-z0-9_-]+$" },
    "discovery_semantics_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "layer": { "type": "string", "const": "tactic" },
    "status": {
      "type": "string",
      "enum": ["staged", "narrowed", "activated", "retired", "judge_skipped", "cap_skipped"]
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "promotion_basis": { "type": "string", "enum": ["invariant_backed", "case_cluster"] },
    "derivation_method": { "type": "string", "minLength": 1 },
    "source_case_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" }
    },
    "supporting_invariant_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "entry": {
      "type": "object",
      "minProperties": 1
    },
    "support_signals": {
      "type": "object",
      "additionalProperties": true,
      "required": ["score", "shared_tokens"],
      "properties": {
        "score": { "type": "number", "minimum": 0 },
        "shared_tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counterexample_case_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "decision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decided_at", "decision", "rationale"],
        "properties": {
          "decided_at": { "type": "string", "format": "date-time" },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
