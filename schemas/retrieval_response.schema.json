{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "generated_at", "results", "explanations"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tactics", "invariants", "cases", "evidence"],
      "properties": {
        "tactics": { "type": "array", "items": { "type": "string", "pattern": "^tac_[A-Za-z0-9_-]+$" } },
        "invariants": { "type": "array", "items": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" } },
        "cases": { "type": "array", "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" } },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" } }
      }
    },
    "explanations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
