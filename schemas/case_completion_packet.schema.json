{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completion_id",
    "case_id",
    "base_case_version",
    "evidence_refs",
    "prepared_at",
    "prepared_by",
    "strategy_id",
    "open_questions",
    "facts",
    "boundaries",
    "suggested_applicability"
  ],
  "properties": {
    "completion_id": { "type": "string", "pattern": "^ccx_[A-Za-z0-9_-]+$" },
    "case_id": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" },
    "base_case_version": { "type": "integer", "minimum": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "prepared_at": { "type": "string", "format": "date-time" },
    "prepared_by": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1 },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/support_item" }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/support_item" }
    },
    "suggested_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_to_apply", "when_not_to_apply"],
      "properties": {
        "when_to_apply": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/suggested_line" }
        },
        "when_not_to_apply": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/suggested_line" }
        }
      }
    }
  },
  "definitions": {
    "support_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_id",
        "text",
        "evidence_ref",
        "source_kind",
        "source_field"
      ],
      "properties": {
        "support_id": { "type": "string", "pattern": "^sup_[A-Za-z0-9_-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" },
        "source_kind": { "type": "string", "enum": ["case", "evidence_payload"] },
        "source_field": { "type": "string", "minLength": 1 }
      }
    },
    "suggested_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "support_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "support_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sup_[A-Za-z0-9_-]+$" }
        }
      }
    }
  }
}
