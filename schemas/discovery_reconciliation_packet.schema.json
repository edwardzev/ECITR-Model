{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecitr.dev/schema/discovery_reconciliation_packet.schema.json",
  "title": "DiscoveryReconciliationPacket",
  "type": "object",
  "required": [
    "reconciliation_id",
    "target_layer",
    "source_record_type",
    "source_record_id",
    "source_snapshot_hash",
    "outcome",
    "rationale",
    "related_record_refs",
    "reconciled_at"
  ],
  "additionalProperties": false,
  "properties": {
    "reconciliation_id": {
      "type": "string",
      "pattern": "^[a-z0-9_:-]+$"
    },
    "target_layer": {
      "type": "string",
      "enum": ["case", "invariant", "tactic"]
    },
    "source_record_type": {
      "type": "string",
      "enum": ["evidence", "case", "invariant"]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_status": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": "string",
      "enum": ["promoted", "covered", "blocked"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "related_record_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
