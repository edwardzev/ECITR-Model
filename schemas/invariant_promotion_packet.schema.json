{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promotion_id",
    "promotion_basis",
    "series_key",
    "title",
    "summary",
    "statement",
    "source_case_refs",
    "evidence_refs",
    "why_it_is_stable",
    "scope",
    "non_scope",
    "applicability_conditions",
    "non_applicability_conditions",
    "known_breakers",
    "tool_agnosticity_level",
    "confidence"
  ],
  "properties": {
    "promotion_id": { "type": "string", "pattern": "^ipp_[A-Za-z0-9_-]+$" },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "promotion_basis": { "type": "string", "enum": ["multi_case", "human_approved_single_case"] },
    "proposed_invariant_id": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "series_key": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "source_case_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" } },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" } },
    "why_it_is_stable": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "applicability_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "non_applicability_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "known_breakers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tool_agnosticity_level": { "type": "string", "enum": ["high", "medium", "low"] },
    "supersedes": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" },
    "review_due_at": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
