{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recovery_id",
    "case_id",
    "base_case_version",
    "evidence_refs",
    "recovered_at",
    "recovered_by",
    "strategy_id",
    "candidate_boundaries",
    "suggested_failure_mode"
  ],
  "properties": {
    "recovery_id": { "type": "string", "pattern": "^crx_[A-Za-z0-9_-]+$" },
    "case_id": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" },
    "base_case_version": { "type": "integer", "minimum": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "recovered_at": { "type": "string", "format": "date-time" },
    "recovered_by": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1 },
    "candidate_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/support_item" }
    },
    "suggested_failure_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "support_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "support_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^sup_[A-Za-z0-9_-]+$" }
        }
      }
    }
  },
  "definitions": {
    "support_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_id",
        "text",
        "evidence_ref",
        "source_kind",
        "source_field"
      ],
      "properties": {
        "support_id": { "type": "string", "pattern": "^sup_[A-Za-z0-9_-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "evidence_ref": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" },
        "source_kind": { "type": "string", "enum": ["case", "evidence_payload"] },
        "source_field": { "type": "string", "minLength": 1 }
      }
    }
  }
}
