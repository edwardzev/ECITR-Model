{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promotion_id",
    "series_key",
    "title",
    "summary",
    "action",
    "source_case_refs",
    "supporting_invariant_refs",
    "evidence_refs",
    "tool_binding",
    "tool_version_bounds",
    "environment_bounds",
    "prerequisites",
    "steps",
    "fallbacks",
    "rollback",
    "confidence"
  ],
  "properties": {
    "promotion_id": { "type": "string", "pattern": "^tpp_[A-Za-z0-9_-]+$" },
    "promotion_basis": { "type": "string", "enum": ["invariant_backed", "case_cluster"] },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "proposed_tactic_id": { "type": "string", "pattern": "^tac_[A-Za-z0-9_-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "series_key": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "source_case_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" } },
    "supporting_invariant_refs": { "type": "array", "items": { "type": "string", "pattern": "^inv_[A-Za-z0-9_-]+$" } },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" } },
    "parameter_observation_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^paramobs_[A-Za-z0-9_-]+$" }
    },
    "tool_binding": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tool_version_bounds": { "type": "string", "minLength": 1 },
    "environment_bounds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fallbacks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "expiry_at": { "type": "string", "format": "date-time" },
    "revalidate_at": { "type": "string", "format": "date-time" },
    "validated_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "supersedes": { "type": "string", "pattern": "^tac_[A-Za-z0-9_-]+$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["expiry_at"] },
        { "required": ["revalidate_at"] }
      ]
    }
  ]
}
