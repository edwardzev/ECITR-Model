{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compilation_id",
    "evidence_refs",
    "confidence",
    "derivation_rule_id"
  ],
  "properties": {
    "compilation_id": { "type": "string", "pattern": "^ccp_[A-Za-z0-9_-]+$" },
    "proposed_case_id": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" },
    "case_version": { "type": "integer", "minimum": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
    },
    "parameter_observation_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^paramobs_[A-Za-z0-9_-]+$" }
    },
    "problem_statement": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "project_scope": { "type": "string", "enum": ["project", "project_family", "global", "blocked"] },
        "toolchain": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "action_taken": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "failure_mode": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_to_apply", "when_not_to_apply"],
      "properties": {
        "when_to_apply": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "when_not_to_apply": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "derived_from_case_id": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" },
    "supersedes_case_id": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]+$" },
    "authoring_agent": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "derived_at": { "type": "string", "format": "date-time" },
    "derivation_rule_id": { "type": "string", "minLength": 1 },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "anyOf": [
    { "required": ["problem_statement"] },
    { "required": ["action_taken"] },
    { "required": ["outcome"] },
    { "required": ["failure_mode"] },
    { "required": ["context"] },
    { "required": ["applicability"] },
    { "required": ["open_questions"] }
  ]
}
